# ---------------------------------------------------------------------------
# Loka — variables d'environnement (copier vers .env)
# Toutes les valeurs ci-dessous sont des valeurs de DEV. Ne jamais les utiliser en prod.
# ---------------------------------------------------------------------------

# --- Général ---
ENVIRONMENT=dev                      # dev | prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-change-me-please-0123456789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_DEBUG=1

# URL publique du site (sitemap, emails, canonical)
SITE_URL=http://localhost:3000
# URL de l'API vue depuis le navigateur et depuis le conteneur web (SSR)
NEXT_PUBLIC_API_URL=http://localhost:18000/api/v1
API_INTERNAL_URL=http://api:8000/api/v1

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=loka
POSTGRES_USER=loka
POSTGRES_PASSWORD=loka
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgis://loka:loka@postgres:5432/loka

# --- Redis (cache + broker Celery) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Stockage S3 (MinIO en dev) ---
# Bucket public : photos de biens (variantes WebP), servi directement.
# Bucket private : documents d'identité, contrats, adresses exactes. URLs signées uniquement.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # utilisé pour construire les URLs côté navigateur
S3_ACCESS_KEY=loka
S3_SECRET_KEY=loka-minio-secret
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=loka-public
S3_BUCKET_PRIVATE=loka-private
S3_PRIVATE_URL_EXPIRY_SECONDS=300

# --- Auth JWT ---
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_REFRESH_COOKIE_NAME=loka_refresh
JWT_COOKIE_SECURE=0                  # 1 en prod (HTTPS obligatoire)

# --- Emails ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Loka <no-reply@loka.tn>

# --- Paiement ---
PAYMENT_PROVIDER=mock                # mock | konnect | clictopay | flouci (plus tard)

# --- Revalidation ISR Next.js (webhook /api/revalidate) ---
REVALIDATE_URL=http://web:3000/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
